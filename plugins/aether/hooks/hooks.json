{
  "description": "Aether: the SessionStart bootstrap and stale-run sweep, and the usage meter mod",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/aether-session-start\""
          }
        ]
      }
    ]
  },
  "modules": [
    "./register.js"
  ]
}
