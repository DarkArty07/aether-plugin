#!/bin/sh
# Starts Aether mode: Claude Code with the Lead as the session's agent, at max, with permissions
# bypassed, superpowers off and the plugin's own theme, Aether, for the session. The theme is in this
# session's --settings only: it never reaches your settings files, so a plain `claude` keeps yours. It is
# the README's start command and nothing else, so it needs no setup and works the same from bash, fish
# or zsh. Every argument goes on to claude, after the ones below:
#   aether-lead                       an interactive session
#   aether-lead -p "<task>"           one run, no screen
#   aether-lead --resume              the usual flags
#   aether-lead --plugin-dir <worktree>/plugins/aether    a development tree, in place of the installed release
# With no permission prompts, aether-guard is the only check left on an irreversible command, so the
# session refuses one that no grant covers (AETHER_IRREVERSIBLE=enforce) unless the shell already set
# the variable: AETHER_IRREVERSIBLE=log aether-lead only records them.
AETHER_IRREVERSIBLE="${AETHER_IRREVERSIBLE:-enforce}"
export AETHER_IRREVERSIBLE
exec claude --agent aether:lead --effort max --permission-mode bypassPermissions \
  --settings '{"enabledPlugins":{"superpowers@claude-plugins-official":false},"theme":"custom:aether:aether"}' \
  "$@"
