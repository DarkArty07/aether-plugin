#!/usr/bin/env node
'use strict'

// aether-exam store <specs/NNN-topic> [--from <dir>]   keeps an exam (default: .aether-exam/ of this
//                                                        checkout, which is removed once it is kept)
// aether-exam run <specs/NNN-topic> [--ref <commit>]    runs it on a commit (default: HEAD) in a disposable
//                                                        worktree; ok is false when a test failed twice
//
// Prints one JSON line. Exits 1 only when the command itself fails.

const path = require('node:path')
const lib = path.join(__dirname, '..', 'lib')
const { repoPaths } = require(path.join(lib, 'git.js'))
const exam = require(path.join(lib, 'exam.js'))

const USAGE = 'usage: aether-exam store <specs/NNN-topic> [--from <dir>] | run <specs/NNN-topic> [--ref <commit>]'

function value(args, flag) {
  const i = args.indexOf(flag)
  if (i === -1) return null
  const next = args[i + 1]
  if (next === undefined || next.startsWith('--')) throw new Error(`${flag} needs a value`)
  return next
}

function main(argv) {
  const [verb, feature, ...rest] = argv
  const cwd = process.cwd()
  if (!['store', 'run'].includes(verb) || !feature || feature.startsWith('--')) throw new Error(USAGE)
  const normalized = feature.replace(/\/+$/, '')
  if (verb === 'store') {
    const { worktree, mainRoot } = repoPaths(cwd)
    const from = value(rest, '--from')
    const source = from === null ? path.join(worktree, exam.EXAM_DIR) : path.resolve(cwd, from)
    return exam.store(mainRoot, normalized, source, { move: from === null })
  }
  return exam.runExam(cwd, normalized, { ref: value(rest, '--ref') ?? 'HEAD' })
}

try {
  process.stdout.write(`${JSON.stringify(main(process.argv.slice(2)))}\n`)
} catch (err) {
  process.stdout.write(`${JSON.stringify({ error: err.message })}\n`)
  process.exitCode = 1
}
