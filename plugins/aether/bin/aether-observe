#!/usr/bin/env node
'use strict'

// aether-observe hook | file-issues | proposals | models-read
// hook: the handler of the observation hooks; reads the hook's JSON from stdin, prints nothing, always exits 0.
// file-issues: the worker of the automatic issues of the development installation (spec 020); prints one JSON line and
// exits 1 only when the gate or the destination fails.
// proposals: shows the calibration proposals and the frictions of the last reading (spec 036); reads only, exits 0.
// models-read: daily background worker that lists models offered by active harnesses; prints one JSON line and exits 0.
// Any other use prints one JSON line with the usage error and exits 1.

const { readFileSync } = require('node:fs')
const path = require('node:path')
const lib = path.join(__dirname, '..', 'lib')

const USAGE = 'usage: aether-observe hook | file-issues | proposals | models-read'

function hook() {
  try {
    const input = JSON.parse(readFileSync(0, 'utf8'))
    require(path.join(lib, 'observe-hook.js')).handleHook(input)
  } catch {
    // A hook must never print or fail: an unreadable input is nothing to record.
  }
  return 0
}

function filed() {
  const { fileIssues } = require(path.join(lib, 'observe-issue.js'))
  const { dataDir } = require(path.join(lib, 'run.js'))
  const result = fileIssues({ dataDir: dataDir(), env: process.env, now: Date.now() })
  process.stdout.write(`${JSON.stringify(result)}\n`)
  return result.error && result.error !== 'gh-unavailable' ? 1 : 0
}

function fail(message) {
  process.stdout.write(`${JSON.stringify({ error: message })}\n`)
  return 1
}

// The calibration proposals and the frictions of the last reading, one per line, or `no reading yet` when there
// is none. Reads only: it never writes, whatever the reading holds.
function proposals() {
  const { dataDir } = require(path.join(lib, 'run.js'))
  const { readProposalLines } = require(path.join(lib, 'observe-read.js'))
  const lines = readProposalLines(dataDir())
  if (lines === null) {
    process.stdout.write('no reading yet\n')
  } else if (lines.length === 0) {
    process.stdout.write('no proposals or frictions\n')
  } else {
    for (const line of lines) process.stdout.write(`${line}\n`)
  }
  return 0
}

async function modelsRead() {
  let out
  try {
    const { dataDir } = require(path.join(lib, 'run.js'))
    const { runWatch } = require(path.join(lib, 'model-watch.js'))
    const { enabledHarnesses } = require(path.join(lib, 'lanes.js'))
    const env = process.env
    const harnesses = enabledHarnesses({
      AETHER_LANE_HARNESSES: env.AETHER_LANE_HARNESSES || env.CLAUDE_PLUGIN_OPTION_HARNESSES,
    })
    out = await runWatch({ dataDir: dataDir(), harnesses, env, now: Date.now() })
  } catch (err) {
    out = { error: err && err.message ? err.message : String(err) }
  }
  process.stdout.write(`${JSON.stringify(out)}\n`)
  return 0
}

function main(args) {
  const [verb, ...rest] = args
  if (verb === 'hook' && rest.length === 0) return hook()
  if (verb === 'file-issues' && rest.length === 0) return filed()
  if (verb === 'proposals' && rest.length === 0) return proposals()
  if (verb === 'models-read' && rest.length === 0) return modelsRead()
  return fail(USAGE)
}

Promise.resolve()
  .then(() => main(process.argv.slice(2)))
  .then((code) => { process.exitCode = code })
  .catch((err) => {
    process.exitCode = process.argv[2] === 'hook' || process.argv[2] === 'models-read' ? 0 : fail(err.message)
  })
