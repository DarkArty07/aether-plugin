#!/usr/bin/env node
'use strict'

// aether-lane status <run>
// aether-lane start <run> <call> --role <role> --model <lane model> --effort <effort> --digest <digest> [--task <task>]
// aether-lane wait <run> <call> [--max <seconds>]
// aether-lane result <run> <call>
// aether-lane stop <run> [<call>]
// aether-lane design start|reply|end|list ...
// aether-lane _runner <run> <call>   (internal: the detached runner that start launches)

const fs = require('node:fs')
const path = require('node:path')
const calls = require(path.join(__dirname, '..', 'lib', 'lane-calls.js'))

const USAGE =
  'usage: aether-lane status <run> | start <run> <call> --role <role> --model <lane model> --effort <effort> --digest <digest> [--task <task>] | wait <run> <call> [--max <seconds>] | result <run> <call> | stop <run> [<call>] | design ...'

// The value after each --name in args, keyed by name.
function flags(args) {
  const out = {}
  for (let i = 0; i < args.length; i++) {
    if (!args[i].startsWith('--')) throw new Error(`unexpected argument: ${args[i]}`)
    if (i + 1 >= args.length) throw new Error(`${args[i]} needs a value`)
    out[args[i].slice(2)] = args[++i]
  }
  return out
}

function maxSeconds(value) {
  if (value === undefined) return null
  const seconds = Number(value)
  if (!Number.isFinite(seconds) || seconds < 0) throw new Error('--max needs a number of seconds')
  return seconds
}

async function command(argv) {
  const [verb, runId, call, ...rest] = argv
  const cwd = process.cwd()
  if (verb === 'status') return calls.status(cwd, runId)
  if (verb === 'start') return calls.start(cwd, runId, call, flags(rest))
  if (verb === 'wait') return calls.wait(cwd, runId, call, { maxSeconds: maxSeconds(flags(rest).max) })
  if (verb === 'result') return calls.result(cwd, runId, call)
  if (verb === 'stop') return calls.stop(cwd, runId, call ?? null)
  throw new Error(USAGE)
}

async function main() {
  const argv = process.argv.slice(2)
  if (argv[0] === '_runner') {
    await calls.runCall(process.cwd(), argv[1], argv[2])
    return
  }
  if (argv[0] === 'design') {
    const input = argv[1] === 'start' || argv[1] === 'reply' ? fs.readFileSync(0, 'utf8') : ''
    const { exitCode, stdout } = await require(path.join(__dirname, '..', 'lib', 'lane-design.js')).main(argv.slice(1), { input })
    process.stdout.write(stdout)
    process.exitCode = exitCode
    return
  }
  process.stdout.write(`${JSON.stringify(await command(argv))}\n`)
}

main().catch((err) => {
  process.stdout.write(`${JSON.stringify({ error: err.message })}\n`)
  process.exitCode = 1
})
