#!/usr/bin/env node
'use strict'

// aether-lane: superdelegation and external harnesses.
// Calls lib/lane-command.js to handle the lane and seat commands.

const path = require('node:path')
const { main } = require(path.join(__dirname, '..', 'lib', 'lane-command.js'))

main(process.argv.slice(2)).then(
  ({ exitCode = 0 } = {}) => {
    process.exitCode = exitCode
  },
  (err) => {
    process.stdout.write(`${JSON.stringify({ error: err.message })}\n`)
    process.exitCode = 1
  },
)
