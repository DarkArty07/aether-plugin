#!/usr/bin/env node
'use strict'

// aether-session-start: SessionStart hook handler for Aether mode.
// Calls lib/session-start.js to mark the session and inject the Lead bootstrap.

const { readFileSync } = require('node:fs')
const path = require('node:path')
const { main } = require(path.join(__dirname, '..', 'lib', 'session-start.js'))

let input = null
try {
  const raw = readFileSync(0, 'utf8')
  const parsed = JSON.parse(raw)
  if (parsed !== null && typeof parsed === 'object' && !Array.isArray(parsed)) {
    input = parsed
  }
} catch {}

main({
  input,
  env: process.env,
  cwd: process.cwd(),
  stdout: process.stdout,
})
