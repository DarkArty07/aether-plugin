#!/usr/bin/env node
'use strict'

// aether-plan: checks and compiles plans and briefs.
// Calls lib/plan-compile.js to check a plan or compile it for a run.

const path = require('node:path')
const { main } = require(path.join(__dirname, '..', 'lib', 'plan-compile.js'))

main(process.argv.slice(2), { cwd: process.cwd(), stdout: process.stdout })
