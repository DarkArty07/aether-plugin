#!/usr/bin/env node
'use strict'

// aether-plan: checks and compiles plans and briefs, builds /aether:design args, finds the next spec number,
// counts a spec's requirements against the map threshold, and searches, installs or discards design skills.
// Calls lib/plan-compile.js, lib/plan-design.js, lib/plan-number.js, lib/plan-requirements.js or lib/skill-design.js.

const path = require('node:path')
const argv = process.argv.slice(2)
const verb = argv[0]

if (verb === 'next-spec') {
  const { nextSpec } = require(path.join(__dirname, '..', 'lib', 'plan-number.js'))
  nextSpec({ cwd: process.cwd(), stdout: process.stdout })
} else if (verb === 'design-args') {
  const { designArgs } = require(path.join(__dirname, '..', 'lib', 'plan-design.js'))
  designArgs(argv, { cwd: process.cwd(), env: process.env, binDir: __dirname, stdout: process.stdout })
} else if (verb === 'check' || verb === 'compile') {
  const { main } = require(path.join(__dirname, '..', 'lib', 'plan-compile.js'))
  main(argv, { cwd: process.cwd(), stdout: process.stdout })
} else if (verb === 'requirements') {
  const { main } = require(path.join(__dirname, '..', 'lib', 'plan-requirements.js'))
  main(argv, { cwd: process.cwd(), stdout: process.stdout })
} else if (verb === 'skills') {
  const { main } = require(path.join(__dirname, '..', 'lib', 'skill-design.js'))
  process.exit(main(argv, { cwd: process.cwd(), stdout: process.stdout, env: process.env }))
} else {
  const { USAGE } = require(path.join(__dirname, '..', 'lib', 'plan-compile.js'))
  process.stdout.write(JSON.stringify({ ok: false, errors: [USAGE], warnings: [] }) + '\n')
  process.exit(1)
}
