#!/usr/bin/env node
'use strict'

// aether-report --run <id> [--session <id>] [--no-tests]
// aether-report finalize --run <id> [--session <id>] [--no-tests]
// aether-report price <claude -p json output> [--main-model <id>]
// aether-report --seats [--session <id>] [--since <ms>]
// aether-report --delegates [--session <id>] [--since <ms>]

const fs = require('node:fs')
const path = require('node:path')
const lib = path.join(__dirname, '..', 'lib')
const { report, finalize, seatsReport } = require(path.join(lib, 'report.js'))
const { delegatesReport } = require(path.join(lib, 'router-report.js'))
const { loadPrices, priceModelUsage } = require(path.join(lib, 'prices.js'))

const USAGE =
  'usage: aether-report [finalize] --run <id> [--session <id>] [--no-tests] | aether-report --seats [--session <id>] [--since <ms>] | aether-report price <claude-json> [--main-model <id>]'

// The value after a flag, or null when the flag is absent.
function value(args, flag) {
  const i = args.indexOf(flag)
  if (i === -1) return null
  const next = args[i + 1]
  if (next === undefined || next.startsWith('--')) throw new Error(`${flag} needs a value`)
  return next
}

const DELEGATES_USAGE = 'usage: aether-report --delegates [--session <id>] [--since <ms>]'

// --delegates takes only --session and --since, each with a value; anything else is a misuse.
function delegates(argv) {
  const rest = argv.filter((arg) => arg !== '--delegates')
  for (let i = 0; i < rest.length; i += 2) {
    if (rest[i] !== '--session' && rest[i] !== '--since') throw new Error(DELEGATES_USAGE)
    if (rest[i + 1] === undefined || rest[i + 1].startsWith('--')) throw new Error(DELEGATES_USAGE)
  }
  const since = value(rest, '--since')
  if (since !== null && !(Number(since) >= 0)) throw new Error(DELEGATES_USAGE)
  return delegatesReport({ session: value(rest, '--session'), since: since === null ? 0 : Number(since) })
}

function main(argv) {
  if (argv[0] === 'price') {
    if (!argv[1] || argv[1].startsWith('--')) throw new Error(USAGE)
    const output = JSON.parse(fs.readFileSync(argv[1], 'utf8'))
    return priceModelUsage(output, loadPrices(), { mainModel: value(argv, '--main-model') })
  }
  if (argv.includes('--delegates')) return delegates(argv)
  if (argv.includes('--seats')) {
    const since = value(argv, '--since')
    if (since !== null && !(Number(since) >= 0)) throw new Error('--since needs a time in milliseconds')
    return seatsReport({ session: value(argv, '--session'), since: since === null ? 0 : Number(since) })
  }
  const finalizing = argv[0] === 'finalize'
  const rest = finalizing ? argv.slice(1) : argv
  const runId = value(rest, '--run')
  if (!runId) throw new Error(USAGE)
  const options = { session: value(rest, '--session'), tests: !rest.includes('--no-tests') }
  return finalizing ? finalize(process.cwd(), runId, options) : report(process.cwd(), runId, options)
}

try {
  process.stdout.write(JSON.stringify(main(process.argv.slice(2))) + '\n')
} catch (err) {
  process.stdout.write(JSON.stringify({ error: err.message }) + '\n')
  process.exit(1)
}
