#!/usr/bin/env node
'use strict'

// aether-guard: PreToolUse hook. Denies Write, Edit, MultiEdit and NotebookEdit
// on specs and plans unless the writer is the Designer. Always exits with 0.

const fs = require('node:fs')
const { decide } = require('../lib/guard.js')

try {
  const input = JSON.parse(fs.readFileSync(0, 'utf8'))
  const decision = decide(input)
  if (decision) {
    process.stdout.write(JSON.stringify({
      hookSpecificOutput: {
        hookEventName: 'PreToolUse',
        permissionDecision: 'deny',
        permissionDecisionReason: decision.reason,
      },
    }) + '\n')
  }
} catch {
  // Unreadable input allows the tool call.
}
