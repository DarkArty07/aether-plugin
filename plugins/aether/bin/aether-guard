#!/usr/bin/env node
'use strict'

// aether-guard: PreToolUse hook. In an Aether session it denies Write, Edit, MultiEdit and NotebookEdit
// on specs, plans, tasks and the constitution unless the writer is the main session, the Lead or the
// Writer. For Bash it records an irreversible command that no grant covers in .aether/pending.jsonl,
// the owner's list, and refuses it only when AETHER_IRREVERSIBLE is "enforce"; otherwise it only logs
// it. Always exits with 0.

const { readFileSync } = require('node:fs')
const { dataDir } = require('../lib/run.js')
const { isAetherSession } = require('../lib/session.js')
const { decide, decideBash } = require('../lib/guard.js')

try {
  const input = JSON.parse(readFileSync(0, 'utf8'))
  if (input && isAetherSession(dataDir(), input.session_id)) {
    const decision = input.tool_name === 'Bash' ? decideBash(input) : decide(input)
    if (decision) {
      process.stdout.write(JSON.stringify({
        hookSpecificOutput: {
          hookEventName: 'PreToolUse',
          permissionDecision: 'deny',
          permissionDecisionReason: decision.reason,
        },
      }) + '\n')
    }
  }
} catch {
  // Unreadable input allows the tool call.
}
