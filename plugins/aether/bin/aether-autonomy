#!/usr/bin/env node
'use strict'

// aether-autonomy: manages authorizations and run state.
// aether-autonomy trust --author <autor> --quote <texto> [--session <id>] [--remove]
// Calls lib/autonomy-command.js to handle the autonomy commands.

const path = require('node:path')
const { main } = require(path.join(__dirname, '..', 'lib', 'autonomy-command.js'))

try {
  const { code, out } = main(process.argv.slice(2), { cwd: process.cwd(), env: process.env })
  process.stdout.write(JSON.stringify(out) + '\n')
  process.exit(code)
} catch (err) {
  process.stdout.write(JSON.stringify({ error: err.message }) + '\n')
  process.exit(1)
}
