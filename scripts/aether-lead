#!/bin/sh
# Starts Aether mode: Claude Code with the Lead as the session's agent, at xhigh, and with superpowers
# off for the session. It is the README's start command and nothing else, so it needs no setup and
# works the same from bash, fish or zsh. Every argument goes on to claude, after the ones below:
#   aether-lead                       an interactive session
#   aether-lead -p "<task>"           one run, no screen
#   aether-lead --resume              the usual flags
#   aether-lead --plugin-dir <worktree>/plugins/aether    a development tree, in place of the installed release
exec claude --agent aether:lead --effort xhigh \
  --settings '{"enabledPlugins":{"superpowers@claude-plugins-official":false}}' \
  "$@"
